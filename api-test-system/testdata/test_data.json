    "sql_injection_query": {"pageIndex": 1, "pageSize": 10, "userName": "a' OR 1=1 -- "},
    "xss_message": {"title": "<script>alert(1)</script>", "content": "<img src=x onerror=alert(1)>", "receiveUserIds": [1]},
